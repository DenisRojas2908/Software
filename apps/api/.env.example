# Copiar a apps/api/.env y ajustar. Nunca versionar .env (secretos).
PORT=3000
# D-22: PostgreSQL 16 local (Windows). Base de desarrollo:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/svas
# Base de pruebas (los tests la limpian):
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/svas_test
# Supabase (solo despliegue, D-21): usar la cadena del pooler en modo sesión (IPv4)
# DIRECT_URL=
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXPIRA=2h
# F8: herramientas de simulación (reloj, fallos, buzón). Solo ADMINISTRADOR.
DEMO_MODE=true
# D-12: minutos sin pago para considerar abandonada una cotización
MINUTOS_ABANDONO=30
# D-35: tiempo estimado de contacto que se muestra al pedir asesoría (RF-12)
MINUTOS_CONTACTO_ESTIMADO=30
