{
  "name": "svas",
  "private": true,
  "description": "SVAS — Simulación del Sistema de Venta Autónoma de Seguros (proyecto académico SI707V, Grupo 4)",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @svas/api\" \"npm run dev -w @svas/web\"",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm start -w @svas/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "npm run db:migrate -w @svas/api",
    "db:seed": "npm run db:seed -w @svas/api",
    "db:reset": "npm run db:reset -w @svas/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1"
  }
}
